# ============================================
# Railway Parts Recognition CPU Deployment
# 仅用于无 GPU / 无模型联调场景
# ============================================

APP_ENV=production
APP_PORT=65432
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ============================================
# CPU 模式能力开关
# ============================================
ENABLE_CPU_SAFE_MODE=1
ENABLE_GPU_RECONSTRUCTION=0
ENABLE_SEGMENT_MODEL=0
ENABLE_VECTOR_MODELS=0
ENABLE_OCR_MODEL=0

# ============================================
# Main Business MySQL
# ============================================
MAIN_DB_HOST=192.168.100.2
MAIN_DB_PORT=3307
MAIN_DB_USER=root
MAIN_DB_PASSWORD=REMOVED_CREDENTIAL
MAIN_DB_DATABASE=coronavirusdb

# ============================================
# Redis
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Milvus
# ============================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# ============================================
# MinIO
# ============================================
MINIO_ENDPOINT=192.168.100.2:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=REMOVED_CREDENTIAL
MINIO_BUCKET=bfr-ai-files
# 三维重构原始视频独立存储桶
MINIO_RECONSTRUCTION_VIDEO_BUCKET=bfr-3d-videos
# 三维重构结果文件独立存储桶
MINIO_RECONSTRUCTION_FILE_BUCKET=bfr-reconstruction-files
MINIO_SECURE=false

# ============================================
# SGO
# ============================================
SGO_MYSQL_HOST=127.0.0.1
SGO_MYSQL_PORT=33306
SGO_MYSQL_USER=root
SGO_MYSQL_PASSWORD=change_me
SGO_MYSQL_DATABASE=mdpdb
SGO_URL=https://sgo.example.com/uc/sfsso/authByAccount?tenantId=replace_me

# ============================================
# 容器内目录
# ============================================
MODEL_DIR=/models
TEMP_DIR=/app/temp
INDEXING_CHECKPOINT_FILE=/app/state/vector_db/checkpoint.json
INDEXING_LOG_DIR=/app/logs/vector_db
DINOV2_PATCH_TOKENS_DIR=/app/state/vector_db/patch_tokens
RECONSTRUCTION_DATA_PATH=/app/state/reconstruction/data
RECONSTRUCTION_OUTPUT_PATH=/app/state/reconstruction/output

# ============================================
# CPU 设备配置
# ============================================
SIGLIP_DEVICE=cpu
DINOV2_DEVICE=cpu
SAM3_DEVICE=cpu

# 保留默认值，但 CPU 模式下不会主动要求这些模型可用
SAM_MODEL_PATH=sam_vit_h_4b8939/sam_vit_h_4b8939.pth
SIGLIP_MODEL_NAME=google/siglip-so400m-patch14-384
SIGLIP_MODEL_PATH=siglip2-so400m-patch14-384
SIGLIP_VECTOR_DIM=1152
SIGLIP_COLLECTION_NAME=PARTS_SIGLIP_SO400M_1152D_V1
SIGLIP_BATCH_SIZE=32
DINOV2_MODEL_NAME=facebook/dinov2-large
DINOV2_MODEL_PATH=dinov2-large
DINOV2_VECTOR_DIM=1024
DINOV2_COLLECTION_NAME=PARTS_DINOV2_LARGE_1024D_V1
SAM3_MODEL_PATH=sam3
SAM3_MASK_DILATE=5
SAM3_BG_COLOR=black

# ============================================
# 其他
# ============================================
LOCAL_IMAGE_ROOT=/data/railway_parts_images
RECONSTRUCTION_PYTHON_PATH=/usr/local/bin/python
RECONSTRUCTION_3DGS_PATH=csrcqsf/biz/railwayparts/reconstruction_server/3dgs
RECONSTRUCTION_SYNC_INTERVAL=20
BASIS_API_GRPC_URL=10.144.145.6:8701
SEARCH_USE_VEHICLE=false
