# ============================================
# 铁路配件智能识别系统 - 环境变量配置模板
# ============================================
# 说明：复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到 Git
# 当前主业务已不再读取本地模型目录或 SAM 路径配置。

# ============================================
# 基础必配
# ============================================
APP_PORT=65432

# 主业务数据库 - MySQL
MAIN_DB_HOST=192.168.100.2
MAIN_DB_PORT=3307
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your_password_here
MAIN_DB_DATABASE=coronavirusdb

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# MinIO
MINIO_ENDPOINT=192.168.100.2:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=bfr-ai-files
MINIO_SEARCH_HISTORY_BUCKET=bfr-search-history-files
MINIO_RECONSTRUCTION_VIDEO_BUCKET=bfr-3d-videos
MINIO_RECONSTRUCTION_FILE_BUCKET=bfr-reconstruction-files
MINIO_SECURE=false

# SGO 外部业务库类型：mysql 或 kingbase
SGO_DATABASE_TYPE=mysql

# SGO MySQL（SGO_DATABASE_TYPE=mysql 时生效）
SGO_MYSQL_HOST=192.168.100.12
SGO_MYSQL_PORT=33306
SGO_MYSQL_USER=root
SGO_MYSQL_PASSWORD=your_password_here
SGO_MYSQL_DATABASE=mdpdb

# SGO Kingbase（SGO_DATABASE_TYPE=kingbase 时生效）
SGO_KINGBASE_HOST=127.0.0.1
SGO_KINGBASE_PORT=54321
SGO_KINGBASE_USER=system
SGO_KINGBASE_PASSWORD=your_password_here
SGO_KINGBASE_DATABASE=mdpdb

# 主业务运行目录
TEMP_DIR=temp
LOCAL_IMAGE_ROOT=/data/railway_parts_images

# 向量检索运行配置
SIGLIP_COLLECTION_NAME=PARTS_SIGLIP_SO400M_1152D_V1
DINOV2_COLLECTION_NAME=PARTS_DINOV2_LARGE_1024D_V1
DINOV2_PATCH_TOKENS_DIR=state/vector_db/patch_tokens
INDEXING_CHECKPOINT_FILE=state/vector_db/checkpoint.json
INDEXING_LOG_DIR=logs/vector_db

# 外部服务入口
BASIS_API_GRPC_URL=10.144.145.6:8701
BASIS_API_HTTP_URL=http://basis-api.example.com
# 生产环境默认校验文件访问 token，仅在隔离的联调环境临时设为 true
ASSET_PROXY_SKIP_AUTH=false
MODEL_SERVICE_URL=http://localhost:5555
MODEL_SERVICE_INDEX_TIMEOUT_SEC=120
RECONSTRUCTION_SERVER_URL=http://localhost:8000
RECONSTRUCTION_SYNC_INTERVAL=20

# ============================================
# 业务可选配置
# ============================================
# SGO 图片同步（仅在需要同步甲方 SGO 图片时启用）
SGO_ENABLE_IMAGE_SYNC=false
SGO_API_URL=https://sgo.csrcqsf.com
SGO_TENANT_ID=1463844437338755072
SGO_USERNAME=your_username
SGO_PASSWORD=your_password
SGO_ENCRYPTION=your_encryption_key

# 三维重构主业务调用超时（秒）
RECONSTRUCTION_SERVER_TIMEOUT_SEC=10
