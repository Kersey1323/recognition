# ============================================
# 铁路配件智能识别系统 - 环境变量配置模板
# ============================================
# 说明：复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到 Git

# ============================================
# 应用配置
# ============================================
APP_PORT=65432

# ============================================
# 主业务数据库配置 - MySQL
# ============================================
MAIN_DB_HOST=192.168.100.2
MAIN_DB_PORT=3307
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your_password_here
MAIN_DB_DATABASE=coronavirusdb

# ============================================
# Redis配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380

# ============================================
# Milvus向量数据库配置
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================
# MinIO对象存储配置
# ============================================
MINIO_ENDPOINT=192.168.100.2:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=bfr-ai-files
MINIO_RECONSTRUCTION_VIDEO_BUCKET=bfr-3d-videos
MINIO_RECONSTRUCTION_FILE_BUCKET=bfr-reconstruction-files
MINIO_SECURE=false

# ============================================
# SGO系统配置
# ============================================
SGO_MYSQL_HOST=192.168.100.12
SGO_MYSQL_PORT=33306
SGO_MYSQL_USER=root
SGO_MYSQL_PASSWORD=your_password_here
SGO_MYSQL_DATABASE=mdpdb
# 是否启用 SGO 图片同步（需要外网访问 SGO 服务）
SGO_ENABLE_IMAGE_SYNC=false
# SGO 图片同步相关配置（仅 SGO_ENABLE_IMAGE_SYNC=true 时生效）
SGO_API_URL=https://sgo.csrcqsf.com
SGO_TENANT_ID=1463844437338755072
SGO_USERNAME=your_username
SGO_PASSWORD=your_password

# ============================================
# 项目路径配置
# ============================================
# AI模型根目录（绝对路径，三维重构流水线使用）
MODEL_DIR=/home/ubuntu/CV/models
# 临时文件目录（相对于项目根目录）
TEMP_DIR=temp

# ============================================
# 向量数据库配置
# ============================================
# Milvus 集合名称（业务侧查询用）
SIGLIP_COLLECTION_NAME=PARTS_SIGLIP_SO400M_1152D_V1
DINOV2_COLLECTION_NAME=PARTS_DINOV2_LARGE_1024D_V1
DINOV2_PATCH_TOKENS_DIR=csrcqsf/biz/railwayparts/vector_db/patch_tokens
# SAM3模型路径（三维重构流水线本地使用）
SAM3_MODEL_PATH=sam3
# 索引配置
INDEXING_CHECKPOINT_FILE=csrcqsf/biz/railwayparts/vector_db/checkpoint.json
INDEXING_LOG_DIR=csrcqsf/biz/railwayparts/vector_db/logs
# 本地图片根目录（绝对路径）
LOCAL_IMAGE_ROOT=/data/railway_parts_images

# ============================================
# Celery配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
CELERY_TASK_TIME_LIMIT=43200
CELERY_TASK_SOFT_TIME_LIMIT=43000

# ============================================
# Basis API配置
# ============================================
BASIS_API_GRPC_URL=10.144.145.6:8701

# ============================================
# 模型推理服务配置
# ============================================
MODEL_SERVICE_URL=http://localhost:5555

# ============================================
# 重建任务状态同步间隔（秒，默认10）
# ============================================
RECONSTRUCTION_SYNC_INTERVAL=20
