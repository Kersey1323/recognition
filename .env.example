# ============================================
# 铁路配件智能识别系统 - 环境变量配置模板
# ============================================
# 说明：复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到 Git

# ============================================
# 应用配置
# ============================================
APP_ENV=production
APP_PORT=65432
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ============================================
# 主业务数据库配置 - MySQL
# ============================================
MAIN_DB_HOST=192.168.100.2
MAIN_DB_PORT=3307
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your_password_here
MAIN_DB_DATABASE=coronavirusdb

# ============================================
# Redis配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Milvus向量数据库配置
# ============================================
MILVUS_HOST=192.168.100.12
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# ============================================
# MinIO对象存储配置
# ============================================
MINIO_ENDPOINT=192.168.100.2:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=bfr-ai-files
# 三维重构原始视频独立存储桶
MINIO_RECONSTRUCTION_VIDEO_BUCKET=bfr-3d-videos
# 三维重构结果文件独立存储桶
MINIO_RECONSTRUCTION_FILE_BUCKET=bfr-reconstruction-files
MINIO_SECURE=false

# ============================================
# SGO系统配置，用于同步sgo中的配件到算法端的pg数据库
# ============================================
SGO_MYSQL_HOST=192.168.100.12
SGO_MYSQL_PORT=33306
SGO_MYSQL_USER=root
SGO_MYSQL_PASSWORD=your_password_here
SGO_MYSQL_DATABASE=mdpdb
SGO_URL=https://sgo.csrcqsf.com/uc/sfsso/authByAccount?tenantId=1463844437338755072


# ============================================
# 项目路径配置
# ============================================


# 临时文件目录（相对于项目根目录）
TEMP_DIR=temp



# ============================================
# 向量数据库索引配置（相对于项目根目录）
# ============================================
INDEXING_CHECKPOINT_FILE=csrcqsf/biz/railwayparts/vector_db/checkpoint.json
INDEXING_LOG_DIR=logs/vector_db

# 本地图片根目录（绝对路径）
LOCAL_IMAGE_ROOT=/data/railway_parts_images

# ============================================
# Celery配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
CELERY_TASK_TIME_LIMIT=43200
CELERY_TASK_SOFT_TIME_LIMIT=43000

# ============================================
# 3D重构服务配置（相对于项目根目录）
# ============================================
RECONSTRUCTION_PYTHON_PATH=/home/ubuntu/miniconda3/envs/gs3d/bin/python
RECONSTRUCTION_3DGS_PATH=csrcqsf/biz/railwayparts/reconstruction_server/3dgs
RECONSTRUCTION_DATA_PATH=csrcqsf/biz/railwayparts/reconstruction_server/data
RECONSTRUCTION_OUTPUT_PATH=csrcqsf/biz/railwayparts/reconstruction_server/output

# 重建任务状态同步间隔（秒）
# 定时任务会每隔指定秒数自动同步进行中任务的状态到数据库
# 建议值：5-30秒，默认10秒
RECONSTRUCTION_SYNC_INTERVAL=20

# ============================================
# Basis API配置
# ============================================
BASIS_API_GRPC_URL=10.144.145.6:8701

# ============================================
# 模型推理服务配置
# ============================================
MODEL_SERVICE_URL=http://localhost:5555


# ============================================
# 其他配置
# ============================================
SEARCH_USE_VEHICLE=false
