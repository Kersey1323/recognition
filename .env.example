# ============================================
# 铁路配件智能识别系统 - 环境变量配置模板
# ============================================
# 说明：复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到 Git

# ============================================
# 应用配置
# ============================================
APP_ENV=production
APP_PORT=65432
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ============================================
# 数据库配置 - PostgreSQL
# ============================================
PG_HOST=192.168.100.2
PG_PORT=5432
PG_USER=root
PG_PASSWORD=your_password_here
PG_DATABASE=zcsf

# ============================================
# Redis配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Milvus向量数据库配置
# ============================================
MILVUS_HOST=192.168.100.12
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# ============================================
# MinIO对象存储配置
# ============================================
MINIO_ENDPOINT=192.168.100.2:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=bfr-ai-files
MINIO_SECURE=false

# ============================================
# SGO系统配置
# ============================================
SGO_MYSQL_HOST=192.168.100.12
SGO_MYSQL_PORT=33306
SGO_MYSQL_USER=root
SGO_MYSQL_PASSWORD=your_password_here
SGO_MYSQL_DATABASE=mdpdb
SGO_URL=https://sgo.csrcqsf.com/uc/sfsso/authByAccount?tenantId=1463844437338755072

# ============================================
# JWT认证配置
# ============================================
JWT_SECRET_KEY=your_secret_key_change_in_production_please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 项目路径配置
# ============================================
# AI模型根目录（绝对路径）
MODEL_DIR=/home/ubuntu/CV/models

# 临时文件目录（相对于项目根目录）
TEMP_DIR=temp

# ============================================
# AI模型配置（相对于MODEL_DIR的路径）
# ============================================
# SAM模型（相对路径）
SAM_MODEL_PATH=sam_vit_h_4b8939/sam_vit_h_4b8939.pth

# SigLIP模型（相对路径）
SIGLIP_MODEL_NAME=google/siglip-so400m-patch14-384
SIGLIP_MODEL_PATH=siglip2-so400m-patch14-384
SIGLIP_VECTOR_DIM=1152
SIGLIP_COLLECTION_NAME=PARTS_SIGLIP_SO400M_1152D_V1
SIGLIP_BATCH_SIZE=32
SIGLIP_DEVICE=cuda

# DINOv2模型（相对路径）
DINOV2_MODEL_NAME=facebook/dinov2-large
DINOV2_MODEL_PATH=dinov2-large
DINOV2_VECTOR_DIM=1024
DINOV2_COLLECTION_NAME=PARTS_DINOV2_LARGE_1024D_V1
DINOV2_PATCH_TOKENS_DIR=csrcqsf/biz/railwayparts/vector_db/patch_tokens
DINOV2_DEVICE=cuda

# SAM3模型（相对路径）
SAM3_MODEL_PATH=sam3
SAM3_MASK_DILATE=20
SAM3_BG_COLOR=white
SAM3_DEVICE=cuda

# ============================================
# 向量数据库索引配置（相对于项目根目录）
# ============================================
INDEXING_CHECKPOINT_FILE=csrcqsf/biz/railwayparts/vector_db/checkpoint.json
INDEXING_LOG_DIR=csrcqsf/biz/railwayparts/vector_db/logs

# 本地图片根目录（绝对路径）
LOCAL_IMAGE_ROOT=/data/railway_parts_images

# ============================================
# Celery配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
CELERY_TASK_TIME_LIMIT=43200
CELERY_TASK_SOFT_TIME_LIMIT=43000

# ============================================
# 3D重构服务配置（相对于项目根目录）
# ============================================
RECONSTRUCTION_PYTHON_PATH=/home/ubuntu/miniconda3/envs/gs3d/bin/python
RECONSTRUCTION_3DGS_PATH=csrcqsf/biz/railwayparts/reconstruction_server/3dgs
RECONSTRUCTION_DATA_PATH=csrcqsf/biz/railwayparts/reconstruction_server/data
RECONSTRUCTION_OUTPUT_PATH=csrcqsf/biz/railwayparts/reconstruction_server/output

# ============================================
# Basis API配置
# ============================================
BASIS_API_GRPC_URL=10.144.145.6:8701

# ============================================
# 其他配置
# ============================================
SEARCH_USE_VEHICLE=false
