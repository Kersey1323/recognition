# ============================================
# 铁路配件智能识别系统 - 环境变量配置模板
# ============================================
# 说明：复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到 Git
# 当前主业务已不再读取本地模型目录或 SAM 路径配置。

# ============================================
# 基础必配
# ============================================
APP_PORT=65432
APP_ENV=development

# 主业务数据库 - MySQL
MAIN_DB_HOST=192.168.100.2
MAIN_DB_PORT=3307
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your_password_here
MAIN_DB_DATABASE=coronavirusdb

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
AGENT_RUNING=false

# MinIO
MINIO_ENDPOINT=192.168.100.2:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=bfr-ai-files
MINIO_SEARCH_HISTORY_BUCKET=bfr-search-history-files
MINIO_RECONSTRUCTION_VIDEO_BUCKET=bfr-3d-videos
MINIO_RECONSTRUCTION_FILE_BUCKET=bfr-reconstruction-files
MINIO_SECURE=false

# SGO 外部业务库类型：mysql 或 kingbase
SGO_DATABASE_TYPE=mysql

# SGO MySQL（SGO_DATABASE_TYPE=mysql 时生效）
SGO_MYSQL_HOST=192.168.100.12
SGO_MYSQL_PORT=33306
SGO_MYSQL_USER=root
SGO_MYSQL_PASSWORD=your_password_here
SGO_MYSQL_DATABASE=mdpdb

# SGO Kingbase（SGO_DATABASE_TYPE=kingbase 时生效）
SGO_KINGBASE_HOST=127.0.0.1
SGO_KINGBASE_PORT=54321
SGO_KINGBASE_USER=system
SGO_KINGBASE_PASSWORD=your_password_here
SGO_KINGBASE_DATABASE=mdpdb

# 主业务运行目录
APP_LOG_DIR=logs
TEMP_DIR=temp
STATE_DIR=state
LOCAL_IMAGE_ROOT=/data/railway_parts_images

# 向量检索运行配置
SIGLIP_COLLECTION_NAME=PARTS_SIGLIP_SO400M_1152D_V1
DINOV2_COLLECTION_NAME=PARTS_DINOV2_LARGE_1024D_V1
INQUIRY_TEXT_COLLECTION_ALIAS=PARTS_INQUIRY_BGE_M3_CURRENT
INQUIRY_TEXT_EMBEDDING_DIM=1024
INQUIRY_TEXT_INDEX_BATCH_SIZE=128
INQUIRY_TEXT_AUTO_INDEX_ENABLED=true
INQUIRY_TEXT_SEARCH_OVERSAMPLE=5
INQUIRY_TEXT_SEARCH_MIN_CANDIDATES=30
INQUIRY_TEXT_SEARCH_MAX_CANDIDATES=1000
INQUIRY_TEXT_MIN_SCORE=0.55
DINOV2_PATCH_TOKENS_DIR=state/vector_db/patch_tokens
INDEXING_CHECKPOINT_FILE=state/vector_db/checkpoint.json
INDEXING_LOG_DIR=logs/vector_db

# 外部服务入口
BASIS_API_GRPC_URL=10.144.145.6:8701
# 本地可关闭鉴权；需要联调时改为 true 并使用下方固定 Mock Token
AUTH_ENABLED=false
AUTH_PROVIDER=mock
AUTH_MOCK_TOKEN=recognition-dev-token
AUTH_DOCS_PUBLIC=true
AUTH_ALLOWED_ORIGINS=*
SGO_SSO_AUTH_URL=https://sgo.4dlp.com.cn/uc/sso/auth
SGO_SSO_SERVICE=sgo
SGO_SSO_MODE=
SGO_SSO_TIMEOUT_SECONDS=5
AUTH_REDIS_URL=redis://127.0.0.1:6379/0
AUTH_TOKEN_CACHE_TTL_SECONDS=300
AUTH_INVALID_TOKEN_CACHE_TTL_SECONDS=10
MODEL_SERVICE_URL=http://localhost:5555
MODEL_SERVICE_INDEX_TIMEOUT_SEC=120
INDEX_SINGLE_TASK_MAX_CONCURRENCY=16

# Viewer360 视频转多角度图片 Grid（当前仅由 Web 手动创建任务）
VIEWER360_ENABLED=true
VIEWER360_AUTO_CREATE_AFTER_VIDEO_UPLOAD=false
VIEWER360_MAX_CONCURRENT_TASKS=1
VIEWER360_WORK_DIR=/data/viewer360-tasks
VIEWER360_WORK_RETENTION_DAYS=7
VIEWER360_TASK_TIMEOUT_SECONDS=1800
VIEWER360_FFMPEG_THREADS=4
VIEWER360_ROW_COUNT=4
VIEWER360_ROW_DIRECTIONS=1,-1,1,-1
VIEWER360_TRANSITION_SECONDS=2
VIEWER360_FRAMES_PER_ROW=72
VIEWER360_IMAGE_SIZE=1600
VIEWER360_WEBP_QUALITY=90
VIEWER360_CENTER_P95_RATIO=0.015
VIEWER360_MODEL_TIMEOUT_SECONDS=600
RECONSTRUCTION_SERVER_URL=http://localhost:8000
RECONSTRUCTION_SYNC_INTERVAL=20

# ============================================
# 业务可选配置
# ============================================
# SGO 图片同步（仅在需要同步甲方 SGO 图片时启用）
SGO_ENABLE_IMAGE_SYNC=false
SGO_API_URL=https://sgo.4dlp.com.cn
SGO_TENANT_ID=1463844437338755072
SGO_USERNAME=your_username
SGO_PASSWORD=your_password
SGO_ENCRYPTION=your_encryption_key
SGO_PARTS_SYNC_INTERVAL_MINUTES=100
SGO_IMAGE_ITEM_BATCH_SIZE=300
SGO_IMAGE_ZIP_BATCH_SIZE=1
SGO_IMAGE_DOWNLOAD_CONCURRENCY=4
SGO_IMAGE_UPLOAD_CONCURRENCY=4
SGO_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=120
SGO_IMAGE_DOWNLOAD_RETRIES=3
SGO_IMAGE_ZIP_MAX_BYTES=268435456

# 三维重构主业务调用超时（秒）
RECONSTRUCTION_SERVER_TIMEOUT_SEC=10
