%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E3F2FD', 'edgeLabelBackground':'#ffffff', 'tertiaryColor': '#F3E5F5'}}}%%
flowchart TD
    %% 核心数据源输入
    RAW([📷 原始现场工业配件图像]) ==>|异步调度拉取| PRE[初步预处理与解码]

    %% 分发一：OCR 文字提取旁路
    subgraph OCR_PIPELINE [文本语义多模态流 - CPU轻载]
        direction TB
        PRE -.-> OCR[🔎 RapidOCR  文本检测与识别]
        OCR -->|提取出配件标牌/型号字符串| SBERT[📝 Sentence-BERT 语义编码模型]
        SBERT -->|512维 密集文本特征向量| V_TEXT[(Milvus - 文本特征集合)]
    end

    %% 主心骨：SAM 零样本扣图流水线
    subgraph SAM_PIPELINE [核心一：SAM 大模型自动化图像提纯切割]
        direction TB
        PRE ==> SAM_ENCODER[🧠 SAM ViT 图像编码器]
        SAM_ENCODER --> GRID[🎯 32x32 密集锚点全景提示]
        GRID --> DECODER[🧩 SAM 轻量掩码解码器]
        
        DECODER ==> MASKS[多维冗余图层掩码集合 Masks]
        
        %% 数据清洗与阈值过滤
        MASKS --> FILTER1{置信度过滤\nIoU>0.88?}
        FILTER1 -- 是 --> FILTER2{寻找最核心物体\nArea 最大宗排序}
        FILTER2 -->|选定前景主体| BOOL_MASK[✅ 生成二值化布尔掩码]
        
        %% 图形学操作
        BOOL_MASK --> MORPH[⚙️ OpenCV 闭运算填补假阳性镂空]
        MORPH --> CROP_WHITE[⬜ 背景白化极值替换 & Bounding Box 精密裁剪]
    end

    %% 特征分发阶段
    subgraph FEATURE_EXTRACTION [核心二：双轨制视觉特征降维打击]
        direction TB
        CROP_WHITE ==>|✨ 极度纯净的主体配件图像\n先推送 MinIO 归档保存| DISTRIBUTION{并发推断分支}
        
        %% 高精度分支
        DISTRIBUTION ==>|输入 14x14 像素斑块| DINO[🌐 DINOv2-Large\n无监督自注意力机制提取]
        DINO ==> CLS_TOKEN["提取 [CLS] Token\n强烈语义正交化空间"]
        CLS_TOKEN ==> L2_1[L2 归一化处理]
        L2_1 ==>|🚀 1024维 极高精几何向量| V_DINO[("(Milvus - 高精业务集合)")]
        
        %% 低延迟分支
        DISTRIBUTION -.->|调整尺寸至 224x224| RESNET[🚀 ResNet-34\n传统深度残差网络]
        RESNET -.-> GAP[GAP 全局平均池化层]
        GAP -.-> L2_2[L2 归一化处理]
        L2_2 -.->|⚡ 512维 标准轮廓向量| V_RES[("(Milvus - 极速短维集合)")]
    end
    
    %% 连接各子图
    OCR_PIPELINE ~~~ FEATURE_EXTRACTION

    %% 最终成果落地
    V_DINO ====> META_DB[(🐘 PostgreSQL\n写业务记录绑定UUID, 事务提交)]
    V_RES ====> META_DB
    V_TEXT ====> META_DB

    %% 节点样式美化 (使用蓝色/紫色/绿色/橙色的科技感配色)
    style RAW fill:#FFF8E1,stroke:#FF8F00,stroke-width:2px,color:#333
    style SAM_PIPELINE fill:#E8EAF6,stroke:#3F51B5,stroke-width:2px,stroke-dasharray: 5 5
    style FEATURE_EXTRACTION fill:#E0F2F1,stroke:#00897B,stroke-width:2px,stroke-dasharray: 5 5
    style OCR_PIPELINE fill:#FFF3E0,stroke:#EF6C00,stroke-width:2px,stroke-dasharray: 5 5
    
    style V_DINO fill:#1A237E,stroke:#fff,stroke-width:2px,color:#fff
    style V_RES fill:#004D40,stroke:#fff,stroke-width:2px,color:#fff
    style V_TEXT fill:#E65100,stroke:#fff,stroke-width:2px,color:#fff
    style META_DB fill:#01579B,stroke:#fff,stroke-width:3px,color:#fff
    style CROP_WHITE fill:#FFEB3B,stroke:#F57F17,stroke-width:3px,color:#333
