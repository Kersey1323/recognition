# Use a Python image with uv pre-installed
FROM uv:python3.10-bookworm-slim


RUN sed -i 's@deb.debian.org@repo.huaweicloud.com@g' /etc/apt/sources.list.d/debian.sources
# Install the project into `/app`
WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ENV VIRTUAL_ENV=/opt/cohort/venv

RUN apt-get update && apt install -y libgl1-mesa-glx ca-certificates libgomp1 graphviz wget
# Install the project's dependencies using the lockfile and settings
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv venv /opt/cohort/venv \
    && mkdir /opt/ocrmodels \
    && wget https://bfr-app.oss-cn-shenzhen.aliyuncs.com/deploy/ocrmodels.tar.gz \
    && tar zxvf ocrmodels.tar.gz -C /opt/ocrmodels \
    && rm ocrmodels.tar.gz \
    && uv sync --frozen --active --no-install-project --no-dev 

# Then, add the rest of the project source code and install it
# Installing separately from its dependencies allows optimal layer caching
ADD . /app
ADD ./ocrmodels/. /opt/ocrmodels
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --active --no-dev 

# Place executables in the environment at the front of the path
ENV PATH="/opt/cohort/venv/bin:$PATH"

# Reset the entrypoint, don't invoke `uv`
ENTRYPOINT []

# Run the FastAPI application by default
# Uses `fastapi dev` to enable hot-reloading when the `watch` sync occurs
# Uses `--host 0.0.0.0` to allow access from outside the container
CMD ["uv", "run","--active","--no-sync", "main.py"]