flowchart TD
    subgraph SAM_PIPELINE
        direction TB
        %% 前序步骤精简合并
        INPUT[📷 输入图像SAM-ViT全景编码提取] ==> MASKS[解码生成多图层掩码集合Masks]
        
        %% 数据清洗与阈值过滤
        MASKS --> FILTER1{置信度过滤IoU Stability > 0.88?}
        FILTER1 -- 是 --> FILTER2{寻找最核心物体
        Area 像素最大排序}
        FILTER1 -. 否 .-> DISCARD1[🗑️剔除低置信噪点]
        
        FILTER2 -->|选定主体| BOOL_MASK[生成布尔掩码]
        FILTER2 -. 面积偏小 .-> DISCARD2[🗑️剔除干扰物]
        
        %% 图形学操作合并
        BOOL_MASK --> CROP_WHITE[⬜ OpenCV 闭运算修复 & 背景极值白化裁剪]
    end

    %% 最终成果落地
    CROP_WHITE ====> FINAL_IMG([高清纯白底目标零配件图像])

